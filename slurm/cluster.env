# ELSC cluster settings, sourced by every script in slurm/.
# Values are defaults: override any of them in the environment, e.g. PARTITION=gpu.q ./slurm/launch_sweep.sh
# Check partition / GPU names once with ./slurm/check_cluster.sh on the login node.

PARTITION="${PARTITION:-gpu.q}"             # omer-lab gpu-qos: 8 GPUs/user. Do NOT use ss.gpu / haim.gpu (other labs)
GPU_GRES="${GPU_GRES:-gpu:1}"               # pin a type with e.g. gpu:a100:1 (exact names: sinfo -o %G)
# Node features (sinfo -N -o "%N %f"). torch cu128 wheels have no sm_70 kernels, so skip the V100S node.
CONSTRAINT="${CONSTRAINT:-RTX2080Ti|A100|rtxpro}"
CPUS="${CPUS:-4}"
MEM="${MEM:-32G}"
TIME_LIMIT="${TIME_LIMIT:-24:00:00}"
ACCOUNT="${ACCOUNT:-}"                      # set if your lab uses SLURM accounts
MAX_PARALLEL="${MAX_PARALLEL:-8}"           # array throttle: tasks running at once on the shared queue

# Python environment, evaluated inside the job. Examples:
#   ENV_ACTIVATE='source $REPO_DIR/.venv/bin/activate'
#   ENV_ACTIVATE='source ~/miniconda3/etc/profile.d/conda.sh && conda activate 3f'
# The ELSC venv is built from `module load python/3.11.13`; its interpreter needs the module's
# libpython3.11.so, so the lib dir goes on LD_LIBRARY_PATH (`module` may be undefined in batch shells).
[[ -n "${ENV_ACTIVATE:-}" ]] || ENV_ACTIVATE='export LD_LIBRARY_PATH="/ems/elsc-labs/apps/python/3.11.13/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; source "$REPO_DIR/.venv/bin/activate"'

DATA_DIR="${DATA_DIR:-$REPO_DIR/data}"      # persistent copy on NFS, filled by prefetch_data.sh
OUT_DIR="${OUT_DIR:-$REPO_DIR/runs}"        # checkpoints (last.pt) + wandb files; must be persistent
# Copy the dataset to node-local disk before training. Off by default: torchvision's
# MNIST/CIFAR-10 load the whole dataset into RAM at start-up, so NFS is read once per job.
# Turn on for file-per-sample datasets (ImageFolder etc.) or a slow NFS.
STAGE_DATA="${STAGE_DATA:-0}"
SCRATCH_ROOT="${SCRATCH_ROOT:-${TMPDIR:-/tmp}}"

WANDB_PROJECT="${WANDB_PROJECT:-three-factor-learning}"
WANDB_ENTITY="${WANDB_ENTITY:-}"
WANDB_MODE="${WANDB_MODE:-online}"          # offline if compute nodes have no internet; then `wandb sync runs/*/wandb/offline-*`

LOGIN_NODE_REGEX="${LOGIN_NODE_REGEX:-^(bava|loginserver|login)}"
